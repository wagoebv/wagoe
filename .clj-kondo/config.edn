{:hooks {:analyze-call {wagoe.observability.tracing.core/with-span hooks.wagoe.observability.tracing/with-span}}
 :lint-as {wagoe.test/with-test-system clojure.core/let
           wagoe.test/with-test-tenant clojure.core/let
           wagoe.platform.database/with-transaction clojure.core/with-open
           wagoe.platform.shell.adapters.database.common.core/with-transaction clojure.core/with-open
           wagoe.platform.shell.adapters.database.sqlite.core/with-transaction clojure.core/with-open
           wagoe.platform.shell.adapters.database.h2.core/with-transaction clojure.core/with-open
           clojure.test.check.clojure-test/defspec clojure.core/def
           wagoe.search.shell.registry/defsearch clojure.core/def
           wagoe.search.core.index/defsearch clojure.core/def
           wagoe.reports.shell.registry/defreport clojure.core/def
           wagoe.calendar.shell.registry/defevent clojure.core/def
           wagoe.push.shell.registry/defpush clojure.core/def
           wagoe.workflow.shell.registry/defworkflow clojure.core/def
           wagoe.audience.shell.registry/defaudience clojure.core/def}
 ;; JVM-locale case conversion: on tr-TR `I` lowers to dotless `ı`, so userId
 ;; became user-ıd. src uses wagoe.core.utils.text; tests and dev/ are exempt.
 :ns-groups [{:filename-pattern "(^|.*/)(test|dev)/.*" :name not-src}]
 :linters {:discouraged-var {clojure.string/lower-case {:message "Locale-dependent. Use wagoe.core.utils.text/lower-case (wagoe.tools.text in Babashka code)."}
                             clojure.string/upper-case {:message "Locale-dependent. Use wagoe.core.utils.text/upper-case (wagoe.tools.text in Babashka code)."}
                             clojure.string/capitalize {:message "Locale-dependent. Use wagoe.core.utils.text/capitalize (wagoe.tools.text in Babashka code)."}}
           :unresolved-symbol {:exclude [(wagoe.platform.database/with-transaction [tx])
                                         (wagoe.platform.shell.adapters.database.common.core/with-transaction [tx])
                                         ;; spel (Playwright) binding macro: binds the page symbol from a vector.
                                         (com.blockether.spel.core/with-testing-page [pg])]}}
 :config-in-ns {not-src {:linters {:discouraged-var {:level :off}}}
                wagoe.search.shell.registry-test {:linters {:inline-def {:level :off}}}
                wagoe.audience.shell.registry-test {:linters {:inline-def {:level :off}}}
                ;; test stubs intentionally reify only the protocol methods they exercise
                wagoe.admin.shell.http-test {:linters {:missing-protocol-method {:level :off}}}
                wagoe.user.shell.session-rotation-security-test {:linters {:missing-protocol-method {:level :off}}}
                ;; surfaced once CI started linting test/ + dev/ (BOU-213):
                ;; same intentional partial-stub pattern as the two above
                wagoe.user.shell.auth-lockout-fixation-security-test {:linters {:missing-protocol-method {:level :off}}}
                wagoe.user.shell.web-handlers-test {:linters {:missing-protocol-method {:level :off}}}
                wagoe.user.shell.landing-test {:linters {:missing-protocol-method {:level :off}}}
                wagoe.user.shell.auth-hooks-test {:linters {:missing-protocol-method {:level :off}}}
                wagoe.platform.shell.http.rate-limit-interceptor-test {:linters {:missing-protocol-method {:level :off}}}
                wagoe.bench.hotpaths {:linters {:missing-protocol-method {:level :off}}}
                wagoe.reports.shell.service-test {:linters {:missing-protocol-method {:level :off}}}
                wagoe.user.ports {:linters {:redefined-var {:level :off}}}
                build {:linters {:redefined-var {:level :off}}}
                hooks.com.github.seancorfield.next-jdbc {:linters {:redefined-var {:level :off}}}
                hiccup.hooks {:linters {:redefined-var {:level :off}}}}}
