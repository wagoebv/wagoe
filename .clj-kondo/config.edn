{:hooks {:analyze-call {wagoe.observability.tracing.core/with-span hooks.wagoe.observability.tracing/with-span}}
 :lint-as {wagoe.platform.database/with-transaction clojure.core/with-open
           wagoe.platform.shell.adapters.database.common.core/with-transaction clojure.core/with-open
           wagoe.platform.shell.adapters.database.sqlite.core/with-transaction clojure.core/with-open
           wagoe.platform.shell.adapters.database.h2.core/with-transaction clojure.core/with-open
           clojure.test.check.clojure-test/defspec clojure.core/def
           wagoe.search.shell.registry/defsearch clojure.core/def
           wagoe.reports.shell.registry/defreport clojure.core/def
           wagoe.calendar.shell.registry/defevent clojure.core/def
           wagoe.push.shell.registry/defpush clojure.core/def
           wagoe.workflow.shell.registry/defworkflow clojure.core/def
           wagoe.audience.shell.registry/defaudience clojure.core/def}
 :linters {:unresolved-symbol {:exclude [(wagoe.platform.database/with-transaction [tx])
                                         (wagoe.platform.shell.adapters.database.common.core/with-transaction [tx])
