{;; shop — test configuration
 :active
 { :wagoe/settings
   {:name             "shop-test"
    :version          "0.1.0"
    :date-format      "yyyy-MM-dd"
    :date-time-format "yyyy-MM-dd HH:mm:ss"
    ;; The zone the admin shows and reads timestamps in when the browser has
    ;; not said which it is in. Storage and the JVM stay UTC (BOU-431).
    :time-zone        "Europe/Amsterdam"
    :features         {}}

   ;; :migrate-on-start? is what gives this profile any tables at all. The
   ;; database is in-memory and lives inside the app's own JVM, so a separate
   ;; `clojure -M:migrate up` cannot reach it — without this, every route that
   ;; queries anything answers 500 (BOU-485).
   :wagoe/h2
   {:memory            true
    :migrate-on-start? true
    :pool              {:minimum-idle 1 :maximum-pool-size 5}}

   ;; Every route needs a rule, or it answers 403: `:public true`,
   ;; `:authorization :signed-in` or `:self`, a `:permission`, or its module's
   ;; <module>/read and <module>/write, which a scaffolded module's routes get.
   ;; A platform admin passes all of them; everyone else gets rights through a
   ;; group's roles. `clojure -M:run authz-report` lists the routes.
   :wagoe/authorization
   {:mode :enforce}

   ;; INFO, not quieter: the port the app bound is logged at INFO, and
   ;; scripts/example-smoke.sh reads it from there.
   :wagoe/logging
   {:provider :slf4j :level :info}

   :wagoe/user
   {}

   ;; Product module (bb scaffold integrate)
   :wagoe/product
   {:enabled? true}}

 :inactive
 {}}
