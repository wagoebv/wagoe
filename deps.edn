           ;; Reports - PDF and Excel generation
           com.openhtmltopdf/openhtmltopdf-pdfbox     {:mvn/version "1.0.10"}
           ;; docjure brings log4j-api 2.24.3 (CVE-2026-49844) and commons-lang3 3.16.0 (CVE-2025-48924) (BOU-618).
           org.apache.logging.log4j/log4j-api {:mvn/version "2.26.1"}
           org.apache.commons/commons-lang3   {:mvn/version "3.21.0"}
           dk.ative/docjure                           {:mvn/version "1.22.0"}

           ;; Calendar - iCal generation and parsing
           org.mnode.ical4j/ical4j                    {:mvn/version "4.3.0"}}

 :aliases {;; =============================================================================
           ;; Development and REPL aliases
           ;; =============================================================================

           ;; JDBC drivers belong here, not only in :dev. The documented REPL
           ;; workflow is `clojure -M:repl-clj` then `(go)`, and (go) builds
           ;; :wagoe/db-context — without a driver it died with
           ;; ClassNotFoundException: org.h2.Driver, for every profile. The
           ;; same four are already in :dev, :db, :test, :run and seven others,
           ;; so this adds no new artifact to resolve.
           :repl-clj  {:extra-paths ["dev" "dev/repl"
                                     "libs/devtools/src"
                                     "libs/devtools/resources"]
                       :extra-deps  {nrepl/nrepl                 {:mvn/version "1.7.0"}
                                     cider/cider-nrepl           {:mvn/version "0.62.2"}
                                     ring/ring-jetty-adapter     {:mvn/version "1.15.5"}
                                     org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                     org.postgresql/postgresql {:mvn/version "42.7.13"}
                                     com.h2database/h2 {:mvn/version "2.5.250"}
                                     com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :main-opts   ["-m" "nrepl.cmdline" "--port" "7888" "--middleware" "[cider.nrepl/cider-middleware]"]
                       :jvm-opts    ["-Duser.timezone=UTC"]}
           :repl-cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                                    cider/cider-nrepl         {:mvn/version "0.62.2"}
                                    cider/piggieback          {:mvn/version "0.7.0"}}
                       :main-opts  ["-m" "nrepl.cmdline" "--middleware"
                                    "[cider.nrepl/cider-middleware,cider.piggieback/wrap-cljs-repl]"]}

           ;; =============================================================================
           ;; Database JDBC drivers:
           ;; Drivers are now loaded dynamically based on active databases in config
           ;; Include all common drivers to support all possible configurations
           ;; =============================================================================

           :db        {:extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                    org.postgresql/postgresql {:mvn/version "42.7.13"}
                                    com.h2database/h2 {:mvn/version "2.5.250"}
                                    com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :jvm-opts   ["-Duser.timezone=UTC"]}

           ;; =============================================================================
           ;; Environment aliases with database support
           ;; Use :db alias to include all database drivers, actual drivers loaded by config
           ;; =============================================================================

           :dev       {:extra-paths ["dev" "dev/repl"
                                     "libs/devtools/src"
                                     "libs/devtools/resources"]
                       :extra-deps  {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                     org.postgresql/postgresql {:mvn/version "42.7.13"}
                                     com.h2database/h2 {:mvn/version "2.5.250"}
                                     com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :jvm-opts    ["-Duser.timezone=UTC"]}
           :prod      {:extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                    org.postgresql/postgresql {:mvn/version "42.7.13"}
                                    com.h2database/h2 {:mvn/version "2.5.250"}
                                    com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :jvm-opts   ["-Duser.timezone=UTC"]}

           ;; =============================================================================
           ;; Tool and utility aliases
           ;; =============================================================================

           :cljfmt    {:extra-deps {lein-cljfmt/lein-cljfmt {:mvn/version "0.9.2"}}}
           :main-opts ["-m" "cljfmt.main"]
           :docs-lint {:extra-paths ["dev"]
                       :main-opts   ["-m" "wagoe.tools.docs-lint"]}
           :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
                       :main-opts    ["-m" "clj-kondo.main"]
                       :extra-paths  ["src"]}
           ;; test-resources/ holds logback-test.xml and must stay OFF the main
           ;; :paths. Logback resolves logback-test.xml BEFORE logback.xml, so
           ;; while it sat in resources/ it shadowed the real config everywhere —
           ;; including inside the uberjar, where it pinned ROOT to ERROR and
           ;; silenced production logging entirely (BOU-251).
           :test      {:main-opts   ["-m" "kaocha.runner"]
                       :extra-paths ["test" "dev" "test-resources"
                                     "libs/devtools/src" "libs/devtools/test"
                                     "libs/devtools/resources"]
                       ;; Everything here is resolved by all 30 per-library CI
                       ;; jobs, so one flaky artifact fails them all under an
                       ;; innocent library's name (BOU-260). Keep it to what
                       ;; every suite genuinely needs: kaocha, the JDBC drivers
                       ;; (loaded by URL rather than by require, so no grep can
                       ;; prove which suite needs which), and test.check, used
                       ;; by six libraries. Anything narrower belongs in an
                       ;; alias below, added by the jobs that need it.
                       :extra-deps  {lambdaisland/kaocha           {:mvn/version "1.91.1392"}
                                     org.clojure/test.check        {:mvn/version "1.1.3"}
                                     ;; Required, despite no namespace requiring
                                     ;; it: malli's generator loads it
                                     ;; reflectively for `:re` schemas. Grepping
                                     ;; for it finds nothing, and removing it on
                                     ;; that basis fails 24 property tests with
                                     ;; :test-chuck-not-available (BOU-260).
                                     com.gfredericks/test.chuck    {:mvn/version "0.2.15"}
                                     org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                     org.postgresql/postgresql {:mvn/version "42.7.13"}
                                     com.h2database/h2 {:mvn/version "2.5.250"}
                                     com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Duser.timezone=UTC"]}

           ;; Embedded PostgreSQL, for the admin suite's PG integration tests.
           ;; Split out of :test because the two platform binaries are ~90 MB —
           ;; a third of that alias's entire download volume — and only one
           ;; library uses them (BOU-260).
           :test/pg   {:extra-deps {io.zonky.test/embedded-postgres {:mvn/version "2.2.2"
                                                                     ;; Its driver is 42.7.10 (CVE-2026-42198, -54291); :test brings 42.7.13 (BOU-618).
                                                                     :exclusions [org.postgresql/postgresql]}
                                    io.zonky.test.postgres/embedded-postgres-binaries-linux-amd64 {:mvn/version "18.6.0"}}}

           ;; The macOS binary, for local runs on Apple Silicon. Deliberately
           ;; not in :test/pg: every CI job is ubuntu-latest, so all 52 of them
           ;; were downloading 61.8 MB for a platform CI never runs on.
           :test/pg-mac {:extra-deps {io.zonky.test.postgres/embedded-postgres-binaries-darwin-arm64v8 {:mvn/version "18.6.0"}}}

           ;; OpenTelemetry in-memory exporters — observability's OTLP suites only.
           :test/otel {:extra-deps {io.opentelemetry/opentelemetry-sdk-testing {:mvn/version "1.66.0"}}}

           ;; HTTP client for the devtools dashboard server test only.
           :test/http {:extra-deps {org.clj-commons/clj-http-lite {:mvn/version "1.0.13"}}}

           ;; In-process IMAP server for the external suite. Its bundled
           ;; org.eclipse.angus/jakarta.mail duplicates angus-mail, the one under test.
           :test/mail {:extra-deps {com.icegreen/greenmail {:mvn/version "2.1.14"
                                                            :exclusions [org.eclipse.angus/jakarta.mail junit/junit]}}}

           ;; In-process FTPS server (Apache MINA) for the external suite.
           :test/ftp  {:extra-deps {org.apache.ftpserver/ftpserver-core {:mvn/version "1.2.1"}
                                    ;; ftpserver 1.2.1 pulls mina-core 2.2.4 (CVE-2026-41635 and others)
                                    org.apache.mina/mina-core {:mvn/version "2.2.10"}}}

           ;; Everything the root suite needs, for running it in one command.
           ;;
           ;; `clojure -M:test` alone runs kaocha's default, which discovers
           ;; every suite — including the ones whose dependencies moved out of
           ;; :test — so it fails on ClassNotFoundException before a single
           ;; test runs. Splitting the alias without this made the documented
           ;; main command unusable.
           ;;
           ;; The macOS binary is included: this alias is for local runs, where
           ;; the download happens once into ~/.m2. CI never uses it — the
           ;; per-library jobs request only what they need, which is the whole
           ;; point of the split (BOU-260).
           :test/all  {:extra-deps {io.zonky.test/embedded-postgres {:mvn/version "2.2.2"
                                                                     ;; Its driver is 42.7.10 (CVE-2026-42198, -54291); :test brings 42.7.13 (BOU-618).
                                                                     :exclusions [org.postgresql/postgresql]}
                                    io.zonky.test.postgres/embedded-postgres-binaries-linux-amd64 {:mvn/version "18.6.0"}
                                    io.zonky.test.postgres/embedded-postgres-binaries-darwin-arm64v8 {:mvn/version "18.6.0"}
                                    io.opentelemetry/opentelemetry-sdk-testing {:mvn/version "1.66.0"}
                                    org.clj-commons/clj-http-lite {:mvn/version "1.0.13"}
                                    com.icegreen/greenmail {:mvn/version "2.1.14"
                                                            :exclusions [org.eclipse.angus/jakarta.mail junit/junit]}
                                    org.apache.ftpserver/ftpserver-core {:mvn/version "1.2.1"}
                                    org.apache.mina/mina-core {:mvn/version "2.2.10"}}}
           :outdated  {:extra-deps {olical/depot {:mvn/version "2.4.1"}}
                       :main-opts  ["-m" "depot.outdated.main"]}
           :build     {:main-opts  ["-m" "build"]
                       :extra-deps {org.clojure/clojure           {:mvn/version "1.12.6"}
                                    io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd3"}}
                       :ns-default build}
           :migrate   {:main-opts  ["-m" "wagoe.platform.shell.database.cli-migrations"]
                       :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                    org.postgresql/postgresql {:mvn/version "42.7.13"}
                                    com.h2database/h2 {:mvn/version "2.5.250"}
                                    com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :jvm-opts   ["-Duser.timezone=UTC"]}
           :seed      {:main-opts  ["-m" "wagoe.platform.shell.database.cli-seed"]
                       :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                    org.postgresql/postgresql {:mvn/version "42.7.13"}
                                    com.h2database/h2 {:mvn/version "2.5.250"}
                                    com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :jvm-opts   ["-Duser.timezone=UTC"]}
           :bench     {:extra-paths ["dev"]
                       :extra-deps  {criterium/criterium {:mvn/version "0.4.6"}}
                       :main-opts   ["-m" "wagoe.bench.core"]}
           :coverage  {;; With :test and :test/all, through every kaocha suite.
                       ;; `bb coverage` passes the paths to measure, read from tests.edn,
                       ;; so no list here can fall behind it (BOU-620).
                       :extra-deps  {lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}
                       ;; INFO, as the application logs: under logback-test.xml the
                       ;; arguments of log calls never run and read as uncovered.
                       :jvm-opts    ["-Dlogback.configurationFile=resources/logback.xml"]}

           ;; =============================================================================
           ;; End-to-end test suite (spel / Playwright Java via Clojure)
           ;;
           ;; Opt-in only — activating this alias pulls in Playwright Java browser
           ;; bindings, which are large and not needed by normal :test runs.
           ;; Usage:
           ;;   clojure -M:test:e2e :e2e
           ;; or via the bb task:
           ;;   bb e2e
           ;; =============================================================================

           :e2e       {:extra-paths ["libs/e2e/src" "libs/e2e/test"]
                       :extra-deps  {com.blockether/spel {:mvn/version "0.9.34"}
                                     ;; axe.min.js, injected by the accessibility test
                                     org.webjars.npm/axe-core {:mvn/version "4.13.0"}}}

           ;; =============================================================================
           ;; CLI Interface
           ;; =============================================================================

           :cli       {:extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                    org.postgresql/postgresql {:mvn/version "42.7.13"}
                                    com.h2database/h2 {:mvn/version "2.5.250"}
                                    com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :main-opts  ["-m" "wagoe.cli"]
                       :jvm-opts   ["-Duser.timezone=UTC"]}

           ;; Direct entrypoint into the user module CLI; used by bb create-admin so that
           ;; generated projects (which do not have wagoe.cli on the classpath) can still
           ;; run the user CLI via -M:user-cli.
           ;; Must include all JDBC drivers because db-factory resolves the driver at runtime.
           ;;
           ;; -m, not -e. This used to call run-cli! from an -e expression reading
           ;; *command-line-args*, to avoid requiring a -main entrypoint. That is what
           ;; broke it: with -e, clojure.main takes the first non-option argument as a
           ;; script path and binds *command-line-args* to what follows, so `create` was
           ;; dropped and the CLI rejected --email as an unknown global option. Nothing
           ;; could create an admin user (BOU-266).
           :user-cli  {:extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                    org.postgresql/postgresql {:mvn/version "42.7.13"}
                                    com.h2database/h2 {:mvn/version "2.5.250"}
                                    com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :main-opts  ["-m" "wagoe.user.shell.cli-entry"]
                       :jvm-opts   ["-Duser.timezone=UTC"]}

           ;; =============================================================================
           ;; HTTP server entrypoint (invokes wagoe.main/-main in server mode).
           ;; Used by `bb run-e2e-server` for Playwright/spel e2e runs, and available
           ;; for any local run that needs to boot the Integrant system from deps.edn
           ;; rather than the uberjar. Respects WAG_ENV to select the active profile.
           ;; =============================================================================

           ;; =============================================================================
           ;; MCP server (stdio)
           ;; =============================================================================
           ;; :replace-deps and :replace-paths, not :extra-deps. stdio MCP puts
           ;; JSON-RPC on stdout, and this repository's own resources/logback.xml
           ;; writes there. Worse, logback initialises during classpath startup —
           ;; before -main runs — so no code in the server can prevent it:
           ;; measured, `clojure -Sdeps '{...}' -M -e '(println "MARKER")'` from
           ;; this directory printed 85 banner lines before MARKER. Replacing the
           ;; classpath keeps resources/ off it entirely, and the mcp lib's own
           ;; logback.xml (which targets stderr) applies.
           :mcp       {:replace-paths []
                       :replace-deps  {org.clojure/clojure {:mvn/version "1.12.6"}
                                       wagoe/mcp {:local/root "libs/wagoe-mcp"}}
                       :main-opts     ["-m" "wagoe.mcp.shell.server"]}

           :run       {:extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                                    org.postgresql/postgresql {:mvn/version "42.7.13"}
                                    com.h2database/h2 {:mvn/version "2.5.250"}
                                    com.mysql/mysql-connector-j {:mvn/version "26.7.0"}}
                       :main-opts  ["-m" "wagoe.main"]
                       :jvm-opts   ["-Duser.timezone=UTC"]}

           ;; =============================================================================
           ;; Documentation
           ;; =============================================================================

           :docs      {:exec-fn   clojure.core/sh
                       :exec-args ["scripts/build-docs.sh"]}}}
