           ;; =============================================================================
           ;; End-to-end test suite (spel / Playwright Java via Clojure)
           ;;
           ;; Opt-in only — activating this alias pulls in Playwright Java browser
           ;; bindings, which are large and not needed by normal :test runs.
           ;; Usage:
           ;;   clojure -M:test:e2e :e2e
           ;; or via the bb task:
           ;;   bb e2e
           ;; =============================================================================

           :e2e       {:extra-paths ["libs/e2e/src" "libs/e2e/test"]
                       :extra-deps  {com.blockether/spel {:mvn/version "0.9.8"}}}

           ;; =============================================================================
           ;; CLI Interface
           ;; =============================================================================

           :cli       {:extra-deps {org.xerial/sqlite-jdbc      {:mvn/version "3.53.2.0"}
                                    org.postgresql/postgresql   {:mvn/version "42.7.12"}
                                    com.h2database/h2           {:mvn/version "2.4.240"}
                                    com.mysql/mysql-connector-j {:mvn/version "9.7.0"}}
                       :main-opts  ["-m" "wagoe.cli"]
                       :jvm-opts   ["-Denv=dev"]}

           ;; Direct entrypoint into the user module CLI; used by bb create-admin so that
           ;; generated projects (which do not have wagoe.cli on the classpath) can still
           ;; run the user CLI via -M:user-cli. Uses -e to call run-cli! directly so this
           ;; works with any published wagoe-user without requiring a -main entrypoint.
           ;; Must include all JDBC drivers because db-factory resolves the driver at runtime.
           :user-cli  {:extra-deps {org.xerial/sqlite-jdbc      {:mvn/version "3.53.2.0"}
                                    org.postgresql/postgresql   {:mvn/version "42.7.12"}
                                    com.h2database/h2           {:mvn/version "2.4.240"}
                                    com.mysql/mysql-connector-j {:mvn/version "9.7.0"}}
                       :main-opts  ["-e" "(require '[wagoe.user.shell.cli-entry :as e]) (System/exit (e/run-cli! (vec *command-line-args*)))"]}

           ;; =============================================================================
           ;; HTTP server entrypoint (invokes wagoe.main/-main in server mode).
           ;; Used by `bb run-e2e-server` for Playwright/spel e2e runs, and available
           ;; for any local run that needs to boot the Integrant system from deps.edn
           ;; rather than the uberjar. Respects WAG_ENV to select the active profile.
           ;; =============================================================================

           :run       {:extra-deps {org.xerial/sqlite-jdbc      {:mvn/version "3.53.2.0"}
                                    org.postgresql/postgresql   {:mvn/version "42.7.12"}
                                    com.h2database/h2           {:mvn/version "2.4.240"}
                                    com.mysql/mysql-connector-j {:mvn/version "9.7.0"}}
                       :main-opts  ["-m" "wagoe.main"]}

           ;; =============================================================================
           ;; Documentation
           ;; =============================================================================

           :docs      {:exec-fn   clojure.core/sh
                       :exec-args ["scripts/build-docs.sh"]}}}
