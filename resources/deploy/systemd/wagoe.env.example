# /etc/wagoe/wagoe.env
# Permissions: chmod 600, owned by root
# Referenced by wagoe.service via EnvironmentFile=

# Required
WAG_ENV=prod
# Empty until you set it, so the service will not start without one (BOU-1014):
# openssl rand -base64 32
JWT_SECRET=

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagoe
POSTGRES_USER=wagoe
POSTGRES_PASSWORD=

# HTTP
HTTP_PORT=3000

# Optional: Error reporting
# SENTRY_DSN=https://key@sentry.io/project

# Optional: Redis (enable cache in config.edn first)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: Payments
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Email domain restrictions
# ALLOWED_EMAIL_DOMAIN=yourcompany.com
# ADMIN_EMAIL_DOMAIN=yourcompany.com
