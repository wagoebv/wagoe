{ ;; =============================================================================
 ;; Test Environment Configuration
 ;; =============================================================================

 ;; Enables POST /test/reset endpoint for Playwright e2e tests.
 ;; MUST only ever be true in the :test profile (and optionally :dev).
 ;; Startup wiring asserts the profile and will throw if this flag is set in
 ;; prod/acc. See libs/platform/src/wagoe/platform/shell/system/wiring.clj.
 :test/reset-endpoint-enabled? true

 :active
 {  ;; Core application settings (always active)
  :wagoe/settings
  {:name              "wagoe-test"
   :secure-cookies?   false  ;; test over HTTP
   :version           "0.1.0"
   :date-format       "yyyy-MM-dd"
   :date-time-format  "yyyy-MM-dd HH:mm:ss"
   :currency/iso-code "EUR"
   ;; {:user-web-ui {:enabled? false}} drops the user module's HTML pages
   ;; (API-only); see "Turning the web UI off" in the authentication guide.
   :features          {:user-web-ui {:enabled? #boolean #or [#env WAG_WEB_UI_ENABLED "true"]}}}

  ;; Authentication, sessions and user management. In :active so `migrate up`
  ;; creates its tables (BOU-669). The hook asks a second factor of anyone at
  ;; @mfa-required.test, for the e2e enrolment path.
  :wagoe/user {:auth {:mfa-required? wagoe.test-support.shell.mfa-policy/required?}}

  ;; Active database configurations
  ;; Test environment uses in-memory H2 for fast, isolated tests

  :wagoe/h2
  {:memory true  ; In-memory database for fast test execution
   :pool   {:minimum-idle 1
            :maximum-pool-size 5
            :connection-timeout-ms 5000}}

  ;; HTTP Server configuration (used by `bb run-e2e-server` for Playwright/spel e2e runs).
  ;; Port defaults to 3100 to avoid clashing with a dev server on 3000; override via HTTP_PORT.
  :wagoe/http
  {:port       #long #or [#env HTTP_PORT 3100]
   :host       #or [#env HTTP_HOST "0.0.0.0"]
   :join?      false
   :port-range {:start 3100 :end 3199}
   ;; Short drain window for the test suite; specific drain tests set their own.
   :drain-timeout-ms #long #or [#env HTTP_DRAIN_TIMEOUT_MS 1000]
   ;; CSRF disabled by default for the broad test suite (authenticated POST tests
   ;; do not carry tokens). CSRF-specific tests enable it explicitly via their own
   ;; system/handler config. See wagoe.platform.shell.security-test.
   :security   {:csrf {:enabled? false}}}

  ;; Test logging configuration
  :wagoe/logging
  {:level     :debug  ; Verbose logging for debugging tests
   :console   true    ; Log to console during tests
   :appenders [{:appender       :rolling-file
                :file           "logs/wagoe-test.log"
                :rolling-policy {:type        :time-based
                                 :max-history 3  ; Keep only 3 days of test logs
                                 :max-size    5000000 ; 5MB
                                 :pattern     ".%d{yyyy-MM-dd}.%i.gz"}}]}

  ;; Error reporting configuration for tests
  ;; Defaults to no-op; can be switched to Sentry via ERROR_REPORTING_PROVIDER
  :wagoe/error-reporting
  {:provider    #or [#env "ERROR_REPORTING_PROVIDER" :no-op]
   :dsn         #or [#env "SENTRY_DSN" ""]
   :environment #or [#env "APP_ENV" "test"]
   :release     #or [#env "APP_RELEASE" "test"]
   :sample-rate 1.0}

  ;; Multi-tenancy — tenants, memberships, invites, and the middleware that
  ;; resolves a request's tenant. Was wired unconditionally in code until
  ;; BOU-326; now it is on because this says so.
  :wagoe/tenant
  {:enabled? true
   ;; H2 has no per-tenant schemas; this profile runs tenancy on it anyway.
   :allow-h2? true}

  ;; Workflow engine: its admin list is under e2e
  :wagoe/workflow
  {:enabled? true}

  ;; Admin interface configuration (enabled in tests to satisfy system wiring)
  :wagoe/admin
  {:enabled?         true
   :base-path        "/web/admin"
   :entity-discovery {:mode      :allowlist
                      :allowlist #{:users :tenants :e2e-orders :e2e-order-lines
                                   :e2e-customers :e2e-tickets :e2e-labels
                                   :e2e-ticket-labels :e2e-ticket-watchers
                                   :e2e-products}}
   :entities         #merge [#include "admin/users.edn"
                             #include "admin/tenants.edn"
                             ;; e2e fixture: an order is created with at least one
                             ;; line (BOU-570). wagoe.test-support.shell.reset
                             ;; creates the tables.
                             {:e2e-orders      {:label       "E2E Orders"
                                                :hide-fields #{:status}
                                                :has-many    [{:entity      :e2e-order-lines
                                                               :table       :e2e_order_lines
                                                               :foreign-key :e2e-order-id
                                                               :label       "Lines"
                                                               :fields      [:description :qty]
                                                               :editable    true
                                                               :on-delete   :cascade
                                                               :min         1}]}
                              :e2e-order-lines {:label "Order line"}
                              ;; More customers than :max-page-size: a ticket's
                              ;; customer is a combobox.
                              :e2e-customers   {:label       "E2E Customers"
                                                :title-field :name
                                                :has-many    [{:entity      :e2e-tickets
                                                               :table       :e2e_tickets
                                                               :foreign-key :customer-id
                                                               :label       "Tickets"
                                                               :fields      [:subject]}]}
                              :e2e-tickets     {:label "Ticket"}
                              ;; Join tables to tickets: few labels, many
                              ;; watching customers.
                              :e2e-labels      {:label "E2E Labels" :title-field :name}
                              ;; A decimal and a file field (BOU-798).
                              :e2e-products    {:label "E2E Products" :title-field :name}}]
   :pagination       {:default-page-size 20
                      :max-page-size     200}}

  ;; AI tooling — no-op provider for tests (no network calls, no API keys)
  :wagoe/ai-service
  {:provider :no-op}

  ;; Payment provider — mock adapter for tests (no external calls)
  ;; In-memory: events do not leave the process, which is what a test wants —
  ;; and it keeps the app suite exercising the wiring without needing Redis.
  :wagoe/events
  {:provider :memory}

  :wagoe/payment-provider
  {:provider :mock}}

 :inactive
 {  ;; Alternative test database configurations
  ;; These can be activated for integration testing or specific test scenarios

  :wagoe/sqlite
  {:memory true  ; In-memory SQLite for compatibility testing
   :pool {:minimum-idle 1
          :maximum-pool-size 3
          :connection-timeout-ms 5000}}

  :wagoe/postgresql
  {:host          "localhost"
   :port          5432
   :dbname        "wagoe_test"
   :user          "test_user"
   :password      "test_password"
   :auto-commit   true
   :pool          {:minimum-idle 1
                   :maximum-pool-size 5
                   :connection-timeout-ms 10000}}

  :wagoe/mysql
  {:host          "localhost"
   :port          3306
   :dbname        "wagoe_test"
   :user          "test_user"
   :password      "test_password"
   :pool          {:minimum-idle 1
                   :maximum-pool-size 5
                   :connection-timeout-ms 10000}}}}

