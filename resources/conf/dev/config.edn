{;; =============================================================================
 ;; Development Environment Configuration  
 ;; =============================================================================

 :active
 {;; Core application settings (always active)
  :wagoe/settings
  {:name              "wagoe-dev"
   :secure-cookies?   false  ;; local HTTP dev; set true behind HTTPS
   :version           "0.1.0"
   :date-format       "yyyy-MM-dd"
   :date-time-format  "yyyy-MM-dd HH:mm:ss"
   :currency/iso-code "EUR"

   ;; Feature flags
   :features
   {:user-web-ui {:enabled? #or [#env WAG_WEB_UI_ENABLED true]}}

   ;; User validation configuration
   :user-validation
   {:email-domain-allowlist #{}                             ; Empty set means all domains allowed in dev
    :password-policy        {:min-length             6      ; More lenient for dev
                             :max-length             128
                             :require-uppercase?     false
                             :require-lowercase?     false
                             :require-numbers?       false
                             :require-special-chars? false
                             :forbidden-patterns     #{}}
    :name-restrictions      {:min-length          1
                             :max-length          100
                             :allowed-chars-regex "[\\p{L}\\s\\-'.]+" ; Supports Unicode letters including accented characters
                             :forbidden-names     #{}}
    :role-restrictions      {:allowed-roles       #{:user :admin :manager}
                             :admin-email-domains #{}       ; Empty means any domain can be admin in dev
                             :default-role        :user}
    :user-limits            {:max-users      10000          ; Higher limit for dev
                             :check-enabled? false}         ; Disabled in dev for easier testing
    :cross-field-validation {:admin-requires-company-email? false ; Relaxed for dev
                             :manager-requires-department?  false}}}

  ;; Active database configurations
  ;; Only databases listed here will be loaded and initialized
  :wagoe/postgresql
  {:host        #or [#env POSTGRES_HOST "localhost"]
   :port        #or [#long #or [#env POSTGRES_PORT 5432] 5432]
   :dbname      #or [#env POSTGRES_DB "wagoe_dev"]
   :user        #or [#env POSTGRES_USER "postgres"]
   :password    #or [#env POSTGRES_PASSWORD "postgres"]
   :auto-commit true
   :pool        {:minimum-idle          2
                 :maximum-pool-size     10
                 :connection-timeout-ms 30000}}

  ;; HTTP Server configuration
  ;; Remote-port endpoint for `service` launch mode (BOU-91).
  ;; Present only when this process runs as a module service — it serves that
  ;; module's protocol to the rest of the deployment on its own port, and must
  ;; not be reachable from outside it. The key is at least 32 characters; the
  ;; endpoint refuses to start without one.
  ;; :wagoe/rpc
  ;; {:port        3001
  ;;  :service-key "read from RPC_SERVICE_KEY — at least 32 characters"}
  ;;
  ;; Written without the #env reader macro on purpose: `bb doctor` reads this
  ;; file as text, so a commented-out reference is still reported as an unset
  ;; variable.
  ;;
  ;; Module catalogue for `service` mode — which Integrant keys each module
  ;; owns. Merged over wagoe.config/default-service-catalogue; an entry of the
  ;; same name replaces the framework's outright. The keys must be ones this
  ;; config actually emits: a component nobody claims counts as platform and
  ;; runs in every service.
  ;; :wagoe/services
  ;; {:my-module {:keys [:my-app/service :my-app/routes]}}

  :wagoe/http
  {:port       #long #or [#env HTTP_PORT 3000]
   :host       #or [#env HTTP_HOST "0.0.0.0"]
   :join?      false
   ;; Port conflict resolution - if default port is busy, system will try higher ports
   :port-range {:start 3000 :end 3099}
   ;; Graceful shutdown drain window (ms): stop accepting new connections, let
   ;; in-flight requests finish (up to this bound), then halt. 0 disables.
   :drain-timeout-ms #long #or [#env HTTP_DRAIN_TIMEOUT_MS 5000]
   ;; Per-client rate limiting (fixed window). Uses :wagoe/cache (Redis) for a
   ;; limit shared across replicas; with no active cache it falls back to a
   ;; per-process counter (single-node only) and logs a warning at startup.
   ;; Generous limit for dev so HTMX/admin sub-requests aren't throttled.
   :rate-limit {:enabled?  true
                :limit     #long #or [#env HTTP_RATE_LIMIT 1000]
                :window-ms #long #or [#env HTTP_RATE_LIMIT_WINDOW_MS 60000]}
   ;; CSRF protection for session-authenticated, state-changing requests.
   ;; Protects all POST/PUT/DELETE/PATCH carrying a session cookie (incl. /web/admin).
   ;; Enforcement is OPT-IN (lib default off); dev/prod/acc each set :enabled? true
   ;; explicitly. Dev uses CSRF_SECRET or the literal fallback below; prod/acc require
   ;; JWT_SECRET from the environment. List webhooks/callbacks (which cannot carry a
   ;; token) under :exempt-paths; a trailing /* matches by prefix.
   :security   {:csrf {:enabled?     true
                       :secret       #or [#env CSRF_SECRET "wagoe-dev-csrf-secret-change-me-min-32"]
                       :exempt-paths ["/api/v1/payments/webhook"]}}}

  ;; HTTP Router configuration.
  ;; No :adapter key — Reitit is the router (ADR-037), and naming a seam that
  ;; does not exist is what BOU-357 removed.
  :wagoe/router
  ;; Two routes that can both match a request fail the boot (BOU-356). Add
  ;; `:conflicts nil` here to switch that off — the only value EDN can express
  ;; for it, and the reason it is not written out below.
  {:coercion   :malli                                       ; Request/response coercion. Only :malli is implemented.
   :middleware []}                                          ; Global middleware, appended after the framework's pipeline

  ;; API Versioning configuration
  :wagoe/api-versioning
  {:default-version     :v1                                 ; Default version when not specified
   :latest-stable       :v1                                 ; Latest stable version
   :deprecated-versions #{}                                 ; Set of deprecated versions (e.g., #{:v0})
   :sunset-dates        {}                                  ; Map of version -> ISO date (e.g., {:v0 "2026-06-01"})
   :supported-versions  #{:v1}}                             ; Set of all supported versions

  ;; Pagination configuration
  :wagoe/pagination
  {:default-limit       20                                  ; Default items per page
   :max-limit           100                                 ; Maximum items per page
   :default-type        :offset                             ; Default pagination type (:offset or :cursor)
   :cursor-ttl          3600                                ; Cursor time-to-live in seconds (1 hour)
   :enable-link-headers true}                               ; Enable RFC 5988 Link headers

  ;; Observability configurations
  ;; Using SLF4J provider with Logback backend for unified logging
  :wagoe/logging
  {:provider     :slf4j
   :level        :debug
   :logger-name  "wagoe"
   :default-tags {:service     "wagoe-dev"
                  :environment "development"}}

  :wagoe/metrics
  {:provider :no-op}

  :wagoe/error-reporting
  {:provider :no-op}

  ;; Admin interface configuration
  :wagoe/admin
  {:enabled?         true
   :base-path        "/web/admin"
   :require-role     :admin
   :entity-discovery {:mode      :allowlist
                      :allowlist #{:users :tenants}}
   :entities         #merge [#include "admin/users.edn"
                             #include "admin/tenants.edn"]
   :pagination       {:default-page-size 20
                      :max-page-size     200}}

  ;; Multi-tenancy — tenants, memberships, invites, and the middleware that
  ;; resolves a request's tenant. Was wired unconditionally in code until
  ;; BOU-326; now it is on because this says so.
  :wagoe/tenant
  {:enabled? true}

  ;; Workflow engine configuration
  :wagoe/workflow
  {:enabled? true}

  ;; Search engine configuration
  :wagoe/search
  {:enabled? true}

  ;; Internationalisation — marker-based i18n with EDN catalogues
  :wagoe/i18n
  {:catalogue-path "wagoe/i18n/translations"
   :default-locale :en
   :dev?           true}

  ;; Payment provider — mock adapter for development (no external calls)
  ;; Move to :inactive and configure :mollie or :stripe for real PSP testing.
  :wagoe/payment-provider
  {:provider :mock}

  ;; AI tooling — powers `bb ai` and `bb scaffold ai`.
  ;;
  ;; Offline-first by design: Ollama runs locally, so no prompt leaves the
  ;; machine unless the developer opts in (libs/ai/AGENTS.md). A hosted
  ;; provider here would make a fresh checkout fail on a missing token, and
  ;; would send source code to a third party by default.
  ;;
  ;; This block decides: a :provider named here outranks ANTHROPIC_API_KEY,
  ;; OPENAI_BASE_URL, OPENAI_API_KEY and REPLICATE_API_TOKEN, which are only
  ;; consulted when no :wagoe/ai-service names one (BOU-401). To use a hosted
  ;; provider, edit :provider below — the supported set is :ollama :anthropic
  ;; :openai :replicate :no-op — and keep its key in the environment:
  ;;
  ;;   {:provider :replicate
  ;;    :api-key  #or [#env REPLICATE_API_TOKEN ""]   ; a default, or bb doctor --ci fails
  ;;    :model    #or [#env AI_MODEL "anthropic/claude-4.5-haiku"]}
  ;;
  ;; Keep that edit local — the committed default stays Ollama.
  :wagoe/ai-service
  {:provider :ollama
   :base-url #or [#env OLLAMA_URL "http://localhost:11434"]
   :model    #or [#env AI_MODEL "qwen2.5-coder:7b"]}

  ;; Developer dashboard — live system introspection UI (dev only)
  :wagoe/dashboard {:port 9999}

  ;; Dev-only: an error over HTTP answers with its BND code and the fix
  ;; (BOU-321). Never in prod config — the enrichment is gated on this key and
  ;; on a dev-like environment, and both exist so production says nothing.
  :wagoe/dev-error-enricher {}}

 ;; Guidance engine is managed by the REPL (dev/repl/user.clj), not by Integrant.
 ;; Set level in your REPL: (guidance :minimal) or (guidance :off)

 :inactive
 {;; Cache configuration — move :wagoe/cache to :active to enable Redis caching.
  ;; Requires a Redis instance (e.g. `docker run -p 6379:6379 redis:7-alpine`).
  ;; With :in-memory provider no Redis is needed (useful for local dev without Docker).
  :wagoe/cache
  {:provider    :redis
   :host        #or [#env REDIS_HOST "localhost"]
   :port        #or [#long #or [#env REDIS_PORT 6379] 6379]
   :password    #env REDIS_PASSWORD             ; omit key if no password
   :database    0
   :timeout     2000
   :default-ttl 300                             ; seconds
   :max-total   10
   :max-idle    5
   :min-idle    1}

  ;; Inactive database configurations
  ;; These are available for reference but won't be loaded unless moved to :active

  :wagoe/sqlite
  {:db   "dev-database.db"
   :pool {:minimum-idle          1
          :maximum-pool-size     3
          :connection-timeout-ms 10000}}

  :wagoe/mysql
  {:host     #env "MYSQL_HOST"
   :port     #env "MYSQL_PORT"
   :dbname   #env "MYSQL_DB"
   :user     #env "MYSQL_USER"
   :password #env "MYSQL_PASSWORD"
   :pool     {:minimum-idle          5
              :maximum-pool-size     15
              :connection-timeout-ms 30000}}

  :wagoe/h2
  {:memory true                                               ; For fast in-memory testing
   :pool   {:minimum-idle      1
            :maximum-pool-size 10}}

  ;; Example observability configurations for future use
  ;; Move to :active section when you need real providers

  :wagoe/logging-with-stdout
  {:provider          :stdout
   :level             :debug
   :format            :json
   :colors            true
   :include-timestamp true
   :include-level     true
   :include-thread    false
   :default-tags      {:service "wagoe-dev"}}

  :wagoe/metrics-with-prometheus
  {:provider :prometheus
   :port     9090
   :path     "/metrics"}

  :wagoe/error-reporting-with-sentry
  {:provider    :sentry
   :dsn         #env "SENTRY_DSN"
   :environment "development"}

  :wagoe/metrics-with-datadog
  {:provider    :datadog-statsd
   :host        #or [#env DD_AGENT_HOST "127.0.0.1"]
   :port        #or [#env DD_DOGSTATSD_PORT 8125]
   :service     "wagoe"
   :environment #or [#env WAG_ENV "production"]
   :global-tags ["service:wagoe" "environment:production"]}

  :wagoe/logging-with-file
  {:provider :file
   :level    :debug
   :file     "logs/dev-service.log"
   :format   :json}

  :wagoe/logging-no-op
  {:provider :no-op}

  ;; External service adapters — move to :active to enable.
  ;; All four are opt-in; none are enabled in dev by default.

  :wagoe.external/smtp
  {:host #or [#env SMTP_HOST "localhost"]
   :port #or [#long #or [#env SMTP_PORT 1025] 1025]
   :tls? false
   :from #or [#env SMTP_FROM "no-reply@example.com"]}

  :wagoe.external/imap
  {:host     #or [#env IMAP_HOST "localhost"]
   :port     #or [#long #or [#env IMAP_PORT 993] 993]
   :username #or [#env IMAP_USERNAME "inbox@example.com"]
   :password #env IMAP_PASSWORD
   :ssl?     true}

  ;; Stripe payments now handled by :wagoe/payment-provider (libs/payments).
  ;; Configure with {:provider :stripe :api-key ... :webhook-secret ...} in :active.

  :wagoe.external/twilio
  {:account-sid  #env TWILIO_ACCOUNT_SID
   :auth-token   #env TWILIO_AUTH_TOKEN
   :from-number  #or [#env TWILIO_FROM_NUMBER "+15005550006"]}}}
