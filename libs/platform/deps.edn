{:paths ["src" "resources"]

 :deps  {org.clojure/clojure               {:mvn/version "1.12.6"}
         ;; wagoe.platform.shell.database.cli-migrations requires this — it is
         ;; what `bb migrate` runs. It resolved only through migratus, which
         ;; happens to depend on it, at 1.0.219 rather than the pinned version
         ;; (BOU-273). A transitive that a dependency could drop at any time.
         org.clojure/tools.cli             {:mvn/version "1.4.256"}
         wagoe/observability            {:local/root "../observability"}
         ;; cache is a *ports* dependency: interceptors.clj uses
         ;; wagoe.cache.ports, the protocol, not an implementation. payments,
         ;; realtime and i18n were removed with BOU-131 — platform required
         ;; their module-wiring only to register Integrant keys it does not
         ;; emit, which forced every consumer to ship all three.
         wagoe/cache                    {:local/root "../cache"}
         wagoe/core                     {:local/root "../core"}
         ;; wagoe.platform.shell.system.config reads the loaded config and
         ;; derives the database spec from it. The generated app used to carry
         ;; its own copy of both (BOU-326).
         wagoe/config                   {:local/root "../config"}
         ;; wagoe.platform.shell.rpc.client — the remote-port adapter (BOU-90),
         ;; same client libs/external's outbound adapters use.
         clj-http/clj-http              {:mvn/version "3.13.1"}
         metosin/malli {:mvn/version "0.20.1"}
         org.clojure/tools.logging {:mvn/version "1.3.1"}

         ;; Database
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
         com.github.seancorfield/honeysql  {:mvn/version "2.7.1437"}
         com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
         migratus/migratus                 {:mvn/version "1.6.7"}

         ;; HTTP
         ring/ring-core                    {:mvn/version "1.15.5"}
         ;; ring-jetty-adapter 1.15.5 (latest) brings Jetty 12.1.8: CVE-2026-10050. Every Jetty artifact moves together (BOU-618).
         org.eclipse.jetty/jetty-http                                     {:mvn/version "12.1.14"}
         org.eclipse.jetty/jetty-io                                       {:mvn/version "12.1.14"}
         org.eclipse.jetty/jetty-security                                 {:mvn/version "12.1.14"}
         org.eclipse.jetty/jetty-server                                   {:mvn/version "12.1.14"}
         org.eclipse.jetty/jetty-session                                  {:mvn/version "12.1.14"}
         org.eclipse.jetty/jetty-unixdomain-server                        {:mvn/version "12.1.14"}
         org.eclipse.jetty/jetty-util                                     {:mvn/version "12.1.14"}
         org.eclipse.jetty/jetty-xml                                      {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee/jetty-ee-webapp                             {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9/jetty-ee9-nested                           {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9/jetty-ee9-security                         {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9/jetty-ee9-servlet                          {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9/jetty-ee9-webapp                           {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-jetty-api    {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-jetty-common {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-jetty-server {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-servlet      {:mvn/version "12.1.14"}
         org.eclipse.jetty.websocket/jetty-websocket-core-common          {:mvn/version "12.1.14"}
         org.eclipse.jetty.websocket/jetty-websocket-core-server          {:mvn/version "12.1.14"}
         ring/ring-jetty-adapter           {:mvn/version "1.15.5"}
         ;; buddy-core 1.12.0-430 (latest) brings BouncyCastle 1.78.1: critical CVE-2025-14813, CVE-2026-8763 (BOU-618).
         org.bouncycastle/bcprov-jdk18on {:mvn/version "1.86"}
         org.bouncycastle/bcpkix-jdk18on {:mvn/version "1.86"}
         org.bouncycastle/bcutil-jdk18on {:mvn/version "1.86"}
         buddy/buddy-core                  {:mvn/version "1.12.0-430"}
         metosin/reitit-core               {:mvn/version "0.10.1"}
         metosin/reitit-ring               {:mvn/version "0.10.1"}
         metosin/reitit-malli              {:mvn/version "0.10.1"}
         metosin/reitit-middleware         {:mvn/version "0.10.1"}
         metosin/reitit-swagger            {:mvn/version "0.10.1"}
         metosin/reitit-swagger-ui         {:mvn/version "0.10.1"}
         metosin/muuntaja                  {:mvn/version "0.6.12"}

         ;; Configuration
         integrant/integrant               {:mvn/version "1.0.1"}
         integrant/repl                    {:mvn/version "0.5.1"}
         aero/aero                         {:mvn/version "1.1.6"}
         environ/environ                   {:mvn/version "1.2.0"}
         com.lambdaisland/dotenv           {:mvn/version "0.2.5"}

         ;; JSON
         ;; cheshire brings jackson-core and -databind below 2.22.3: CVE-2026-89407, CVE-2026-89425, CVE-2026-91776, CVE-2026-91777 (BOU-618).
         com.fasterxml.jackson.core/jackson-core     {:mvn/version "2.22.3"}
         com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.22.3"}
         cheshire/cheshire                 {:mvn/version "6.2.0"}}

 :aliases
 {:test      {:extra-paths ["test"]
              ;; payments is here and not in :deps. The RPC round-trip tests
              ;; need a real protocol with a real implementation to prove the
              ;; adapter against, and IPaymentProvider is the pilot BOU-90
              ;; names. Putting it in :deps would invert the dependency —
              ;; infrastructure requiring a feature module — and ship payments
              ;; and its PSP clients to every consumer of platform, which is
              ;; what BOU-131 just finished removing.
              :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                            com.h2database/h2 {:mvn/version "2.5.250"}
                            wagoe/payments      {:local/root "../payments"}}
              :main-opts   ["-m" "kaocha.runner"]}

  :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
              :main-opts    ["-m" "clj-kondo.main"]}

  :build     {:replace-deps {io.github.clojure/tools.build {:git/tag "v0.10.13" :git/sha "3a3c177d"}
                             slipset/deps-deploy           {:mvn/version "0.2.5"}}
              :ns-default   build}}}
