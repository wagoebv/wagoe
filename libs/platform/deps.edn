{:paths ["src" "resources"]

 :deps  {org.clojure/clojure               {:mvn/version "1.12.5"}
         ;; wagoe.platform.shell.database.cli-migrations requires this — it is
         ;; what `bb migrate` runs. It resolved only through migratus, which
         ;; happens to depend on it, at 1.0.219 rather than the pinned version
         ;; (BOU-273). A transitive that a dependency could drop at any time.
         org.clojure/tools.cli             {:mvn/version "1.4.256"}
         wagoe/observability            {:local/root "../observability"}
         ;; cache is a *ports* dependency: interceptors.clj uses
         ;; wagoe.cache.ports, the protocol, not an implementation. payments,
         ;; realtime and i18n were removed with BOU-131 — platform required
         ;; their module-wiring only to register Integrant keys it does not
         ;; emit, which forced every consumer to ship all three.
         wagoe/cache                    {:local/root "../cache"}
         wagoe/core                     {:local/root "../core"}
         metosin/malli {:mvn/version "0.20.1"}
         org.clojure/tools.logging {:mvn/version "1.3.1"}

         ;; Database
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.1108"}
         com.github.seancorfield/honeysql  {:mvn/version "2.7.1388"}
         com.zaxxer/HikariCP               {:mvn/version "7.0.2"}
         migratus/migratus                 {:mvn/version "1.6.6"}

         ;; HTTP
         ring/ring-core                    {:mvn/version "1.15.4"}
         ring/ring-jetty-adapter           {:mvn/version "1.15.4"}
         buddy/buddy-core                  {:mvn/version "1.12.0-430"}
         metosin/reitit-ring               {:mvn/version "0.10.1"}
         metosin/reitit-malli              {:mvn/version "0.10.1"}
         metosin/reitit-middleware         {:mvn/version "0.10.1"}
         metosin/reitit-swagger            {:mvn/version "0.10.1"}
         metosin/reitit-swagger-ui         {:mvn/version "0.10.1"}
         metosin/muuntaja                  {:mvn/version "0.6.11"}

         ;; Configuration
         integrant/integrant               {:mvn/version "1.0.1"}
         integrant/repl                    {:mvn/version "0.5.1"}
         aero/aero                         {:mvn/version "1.1.6"}
         environ/environ                   {:mvn/version "1.2.0"}
         com.lambdaisland/dotenv           {:mvn/version "0.2.5"}

         ;; JSON
         cheshire/cheshire                 {:mvn/version "6.2.0"}}

 :aliases
 {:test      {:extra-paths ["test"]
              :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                            com.h2database/h2   {:mvn/version "2.4.240"}}
              :main-opts   ["-m" "kaocha.runner"]}

  :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.04.15"}}
              :main-opts    ["-m" "clj-kondo.main"]}

  :build     {:replace-deps {io.github.clojure/tools.build {:git/tag "v0.10.13" :git/sha "3a3c177d"}
                             slipset/deps-deploy           {:mvn/version "0.2.3"}}
              :ns-default   build}}}
