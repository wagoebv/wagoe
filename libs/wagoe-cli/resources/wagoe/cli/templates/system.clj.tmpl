(ns {{project-ns}}.system
  (:require [integrant.core :as ig]))

;; System configuration is loaded from resources/conf/{env}/config.edn
;; via Aero. Add module configs with `wagoe add <module>`.

(defmethod ig/init-key :wagoe/settings [_ config] config)

;; Config-only modules — no lifecycle component, init-key exposes config as an Integrant ref.
;; Added by `wagoe add <module>`; ig-config wires them in automatically when present.
(defmethod ig/init-key :wagoe/storage        [_ cfg] cfg)
(defmethod ig/init-key :wagoe/jobs           [_ cfg] cfg)
(defmethod ig/init-key :wagoe/realtime       [_ cfg] cfg)
(defmethod ig/init-key :wagoe/reports        [_ cfg] cfg)
(defmethod ig/init-key :wagoe/calendar       [_ cfg] cfg)
(defmethod ig/init-key :wagoe/ui-style       [_ cfg] cfg)
