(ns {{project-ns}}.system-config
  "This application's configuration and Integrant system.

   Generated by `wagoe new`, and yours to edit. `system-config` reads the
   `:active` keys of `resources/conf/<env>/config.edn` and asks each module the
   config switches on for its own components, so `wagoe add <module>` takes
   effect without a line changing here. What belongs in this file is what only
   this application knows — the two examples below, and your own components.

   Named system-config, not config: `wagoe.config` is a published library that
   reads configuration, and two namespaces of the same name on one classpath
   shadow each other.

   Under `{{project-ns}}`, not under `wagoe`: this is your application's code,
   and the framework's namespace root belongs to the framework's libraries.

   Usage:
     (load-config)               ; raw Aero config map
     (ig-config (load-config))   ; Integrant config map
     (go) / (reset) / (halt)     ; via dev/user.clj"
  (:require [integrant.repl :as ig-repl]
            [wagoe.config :as config]
            [wagoe.platform.shell.system.config :as system]
            ;; Loads the Integrant init/halt methods for the components every
            ;; app has: database, HTTP, router, observability. A module's own
            ;; methods are loaded by `system-config` when the config asks for
            ;; that module, so this list does not grow as you add modules.
            [wagoe.platform.shell.system.wiring]
            ;; Your own Integrant keys. Empty until you add one.
            [{{project-ns}}.system]
            [wagoe.user.schema :as user-schema]))

(defn load-config
  "Load resources/conf/<env>/config.edn, where <env> comes from WAG_ENV."
  ([] (config/load-config))
  ([opts] (config/load-config opts)))

(defn ig-config
  "Build the Integrant system for a loaded config."
  [config]
  (-> (system/system-config
       config
       ;; The user module — auth, sessions, MFA, audit trail, and the four
       ;; tables behind them. Switched on in code rather than in config because
       ;; it is not something you turn on per environment; `wagoe new --no-user`
       ;; writes an empty set here.
       ;;
       ;; :base-ns is where your own modules live. A `:wagoe/product` key in
       ;; config.edn resolves to `{{project-ns}}.product.shell.module-wiring`
       ;; — the config key names the module, this names the code.
       {:extra-modules {{user-modules}}
        :base-ns       "{{project-ns}}"})

      ;; Which of your entities the admin UI manages. The admin module does not
      ;; guess — add a Malli schema per table you want administered.
      (cond-> (get-in config [:active :wagoe/admin])
        (assoc-in [:wagoe/admin-schema-provider :malli-schemas] {:users user-schema/User}))

      ;; Your own components go here:
      ;;
      ;;   (assoc :acme/report-mailer {:email  (ig/ref :wagoe/email)
      ;;                               :db-ctx (ig/ref :wagoe/db-context)})
      ;;
      ;; Anything you assoc wins over what the framework assembled, so this is
      ;; also how you override a framework component you want built differently.
      ))

;; Wire integrant.repl to use this configuration.
;; Loaded automatically via dev/user.clj when starting the REPL.
(ig-repl/set-prep!
 (fn [] (ig-config (load-config))))
