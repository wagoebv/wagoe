(ns boundary.config
  "Application configuration and Integrant system setup.

   Generated by `wagoe new`. ig-config reads :active keys from config.edn
   to determine which optional modules to wire, so `wagoe add <module>` takes
   effect without editing this file.

   Usage:
     (load-config)               ; raw Aero config map
     (ig-config (load-config))   ; Integrant config map
     (go) / (reset) / (halt)     ; via dev/user.clj"
  (:require [aero.core :as aero]
            [clojure.java.io :as io]
            [integrant.core :as ig]
            [integrant.repl :as ig-repl]
            [boundary.user.schema :as user-schema]
            ;; Loads Integrant init/halt multimethods for the platform components
            ;; (db, http, router, observability). Feature-module wiring is loaded
            ;; by the APP, not by platform (BOU-171/192/198): user below, optional
            ;; modules dynamically in ig-config as they are enabled.
            [boundary.platform.shell.system.wiring]
            [boundary.user.shell.module-wiring]
            [boundary.email.shell.module-wiring]
            ;; Registers :wagoe/settings init-key defined in the generated app.
            [{{project-ns}}.system]))

(def ^:private env-aliases
  {"development" "dev"
   "production"  "prod"
   "acceptance"  "acc"
   "testing"     "test"})

(defn- normalize-env [env]
  (let [s (some-> env str .trim .toLowerCase)]
    (get env-aliases s s)))

(defn load-config
  "Load configuration from resources/conf/{env}/config.edn."
  ([] (load-config {}))
  ([{:keys [profile] :or {profile (keyword (normalize-env (or (System/getenv "WAG_ENV") "dev")))}}]
   (let [p (keyword (normalize-env (name profile)))
         r (io/resource (str "conf/" (name p) "/config.edn"))]
     (when-not r
       (throw (ex-info (str "Config not found: conf/" (name p) "/config.edn")
                       {:profile p})))
     (assoc (aero/read-config r {:profile p}) :wagoe/profile p))))

(defn- db-spec [config]
  (let [active (:active config)]
    (cond
      (:wagoe/h2 active)
      {:adapter       :h2
       :database-path (if (get-in active [:wagoe/h2 :memory])
                        "mem:boundary;DB_CLOSE_DELAY=-1"
                        (get-in active [:wagoe/h2 :db]))
       :pool          (get-in active [:wagoe/h2 :pool])}

      (:wagoe/postgresql active)
      {:adapter  :postgresql
       :host     (get-in active [:wagoe/postgresql :host])
       :port     (get-in active [:wagoe/postgresql :port])
       :name     (get-in active [:wagoe/postgresql :dbname])
       :username (get-in active [:wagoe/postgresql :user])
       :password (get-in active [:wagoe/postgresql :password])
       :pool     (get-in active [:wagoe/postgresql :pool])}

      :else (throw (ex-info "No active database adapter in config"
                            {:active-keys (keys active)})))))

(defn user-validation-config
  "Extract user validation configuration."
  [config]
  (get-in config [:active :wagoe/settings :user-validation] {}))

(defn ig-config
  "Build Integrant configuration map from loaded config.

   Optional modules are auto-detected from the active config:
   - :wagoe/cache        → cache component + user-service/http-handler wiring
   - :wagoe/tenant       → full tenant bundle + http-handler refs
   - :wagoe/admin        → admin bundle + http-handler ref
   - :wagoe/workflow     → workflow bundle + http-handler ref
   - :wagoe/search       → search bundle + http-handler ref
   - :wagoe/payment-provider → payments component"
  [config]
  (let [active    (:active config)
        ;; Optional module presence flags
        cache?    (boolean (:wagoe/cache active))
        tenant?   (boolean (:wagoe/tenant active))
        admin?    (boolean (:wagoe/admin active))
        workflow? (boolean (:wagoe/workflow active))
        search?   (boolean (:wagoe/search active))
        payments? (boolean (:wagoe/payment-provider active))
        ai?       (boolean (:wagoe/ai-service active))
        geo?      (boolean (:wagoe/geo-service active))
        storage?  (boolean (:wagoe/storage active))
        jobs?     (boolean (:wagoe/jobs active))
        email?    (boolean (:boundary.external/smtp active))
        realtime? (boolean (:wagoe/realtime active))
        reports?  (boolean (:wagoe/reports active))
        calendar? (boolean (:wagoe/calendar active))
        ui-style? (boolean (:wagoe/ui-style active))
        ;; Load module wirings for enabled optional modules. Platform wiring does
        ;; NOT load these (BOU-171/192/198) — the app owns its module loads.
        _         (when tenant?   (require 'boundary.tenant.shell.module-wiring))
        _         (when admin?    (require 'boundary.admin.shell.module-wiring))
        _         (when workflow? (require 'boundary.workflow.shell.module-wiring))
        _         (when search?   (require 'boundary.search.shell.module-wiring))
        _         (when ai?  (require 'boundary.ai.shell.module-wiring))
        _         (when geo? (require 'boundary.geo.shell.module-wiring))

        db       (db-spec config)
        http-cfg (get active :wagoe/http {:port 3000 :host "0.0.0.0" :join? false})
        router   (get active :wagoe/router {:adapter :reitit :coercion :malli :middleware []})
        i18n-cfg (get active :wagoe/i18n {:catalogue-path "boundary/i18n/translations"
                                             :default-locale  :en})
        val-cfg  (get-in active [:wagoe/settings :user-validation] {})

        ;; Build HTTP handler config, injecting optional module refs as they are enabled
        http-handler-cfg (cond-> {:config          config
                                  :user-routes     (ig/ref :wagoe/user-routes)
                                  :router          (ig/ref :wagoe/router)
                                  :logger          (ig/ref :wagoe/logging)
                                  :metrics-emitter (ig/ref :wagoe/metrics)
                                  :tracer          (ig/ref :wagoe/tracing)
                                  :error-reporter  (ig/ref :wagoe/error-reporting)
                                  :user-service    (ig/ref :wagoe/user-service)
                                  :db-context      (ig/ref :wagoe/db-context)
                                  :i18n            (ig/ref :wagoe/i18n)}
                           cache?    (assoc :cache              (ig/ref :wagoe/cache))
                           ;; Tenant middleware is built by the tenant lib's
                           ;; :wagoe/tenant-http-middleware component and injected
                           ;; here via :extra-middleware (BOU-200) — the http-handler
                           ;; no longer constructs it (and ignores :membership-service).
                           tenant?   (assoc :tenant-routes      (ig/ref :wagoe/tenant-routes)
                                            :membership-routes  (ig/ref :wagoe/membership-routes)
                                            :tenant-service     (ig/ref :wagoe/tenant-service)
                                            :extra-middleware   (ig/ref :wagoe/tenant-http-middleware))
                           admin?    (assoc :admin-routes       (ig/ref :wagoe/admin-routes))
                           workflow? (assoc :workflow-routes    (ig/ref :wagoe/workflow-routes))
                           search?   (assoc :search-routes      (ig/ref :wagoe/search-routes)))]

    (cond->
      {:wagoe/settings        (:wagoe/settings active)
       :wagoe/db-context      db
       :wagoe/logging         (get active :wagoe/logging {:provider :no-op})
       :wagoe/metrics         (get active :wagoe/metrics {:provider :no-op})
       :wagoe/tracing         (get active :wagoe/tracing {:provider :no-op})
       :wagoe/error-reporting (get active :wagoe/error-reporting {:provider :no-op})
       :wagoe/email           (get active :wagoe/email {:provider :logging})
       :wagoe/router          router
       :wagoe/i18n            i18n-cfg

       ;; User module (always wired)
       :wagoe/user-db-schema     {:ctx (ig/ref :wagoe/db-context)}
       :wagoe/user-repository    {:ctx (ig/ref :wagoe/db-context)}
       :wagoe/session-repository {:ctx (ig/ref :wagoe/db-context)}
       :wagoe/audit-repository   {:ctx              (ig/ref :wagoe/db-context)
                                     :pagination-config {:default-limit 20 :max-limit 100}}
       :wagoe/mfa-service        {:user-repository (ig/ref :wagoe/user-repository)
                                     :mfa-config      {}}
       :wagoe/auth-service       {:user-repository    (ig/ref :wagoe/user-repository)
                                     :session-repository (ig/ref :wagoe/session-repository)
                                     :mfa-service        (ig/ref :wagoe/mfa-service)
                                     :auth-config        {}}
       :wagoe/user-service       (cond-> {:user-repository    (ig/ref :wagoe/user-repository)
                                             :session-repository (ig/ref :wagoe/session-repository)
                                             :audit-repository   (ig/ref :wagoe/audit-repository)
                                             :validation-config  val-cfg
                                             :auth-service       (ig/ref :wagoe/auth-service)
                                             :logger             (ig/ref :wagoe/logging)
                                             :metrics            (ig/ref :wagoe/metrics)
                                             :error-reporter     (ig/ref :wagoe/error-reporting)}
                                      cache? (assoc :cache (ig/ref :wagoe/cache)))
       :wagoe/user-routes        {:user-service (ig/ref :wagoe/user-service)
                                     :mfa-service  (ig/ref :wagoe/mfa-service)
                                     :email-sender (ig/ref :wagoe/email)
                                     :config       config}

       ;; HTTP layer (always wired; optional module refs injected above)
       :wagoe/http-handler http-handler-cfg
       :wagoe/http-server  (merge http-cfg
                                     {:handler (ig/ref :wagoe/http-handler)
                                      :config  http-cfg})}

      ;; Cache module — enabled by `wagoe add cache`
      cache?
      (assoc :wagoe/cache (:wagoe/cache active))

      ;; Tenant module — enabled by `wagoe add tenant`
      tenant?
      (merge {:wagoe/tenant-db-schema      {:ctx (ig/ref :wagoe/db-context)}
              :wagoe/tenant-repository     {:ctx            (ig/ref :wagoe/db-context)
                                               :logger         (ig/ref :wagoe/logging)
                                               :error-reporter (ig/ref :wagoe/error-reporting)}
              :wagoe/membership-repository {:ctx            (ig/ref :wagoe/db-context)
                                               :logger         (ig/ref :wagoe/logging)
                                               :error-reporter (ig/ref :wagoe/error-reporting)}
              :wagoe/invite-repository     {:ctx            (ig/ref :wagoe/db-context)
                                               :logger         (ig/ref :wagoe/logging)
                                               :error-reporter (ig/ref :wagoe/error-reporting)}
              :wagoe/tenant-service        {:tenant-repository (ig/ref :wagoe/tenant-repository)
                                               :validation-config val-cfg
                                               :logger            (ig/ref :wagoe/logging)
                                               :metrics-emitter   (ig/ref :wagoe/metrics)
                                               :error-reporter    (ig/ref :wagoe/error-reporting)}
              :wagoe/membership-service    {:repository      (ig/ref :wagoe/membership-repository)
                                               :logger          (ig/ref :wagoe/logging)
                                               :metrics-emitter (ig/ref :wagoe/metrics)
                                               :error-reporter  (ig/ref :wagoe/error-reporting)}
              :wagoe/invite-service        {:repository            (ig/ref :wagoe/invite-repository)
                                               :membership-repository (ig/ref :wagoe/membership-repository)
                                               :logger                (ig/ref :wagoe/logging)
                                               :metrics-emitter       (ig/ref :wagoe/metrics)
                                               :error-reporter        (ig/ref :wagoe/error-reporting)}
              :wagoe/tenant-routes         {:tenant-service (ig/ref :wagoe/tenant-service)
                                               :db-context     (ig/ref :wagoe/db-context)
                                               :config         config}
              :wagoe/membership-routes     {:service (ig/ref :wagoe/membership-service)
                                               :config  config}
              ;; Builds the tenant HTTP middleware seq (tenant resolution +
              ;; membership); injected into :wagoe/http-handler via
              ;; :extra-middleware above (BOU-200).
              :wagoe/tenant-http-middleware {:tenant-service     (ig/ref :wagoe/tenant-service)
                                                :membership-service (ig/ref :wagoe/membership-service)
                                                :db-context         (ig/ref :wagoe/db-context)}})

      ;; Admin module — enabled by `wagoe add admin`
      admin?
      (merge {:wagoe/admin-schema-provider {:db-ctx        (ig/ref :wagoe/db-context)
                                               :config        (:wagoe/admin active)
                                               :malli-schemas {:users user-schema/User}}
              :wagoe/admin-service         {:db-ctx          (ig/ref :wagoe/db-context)
                                               :schema-provider (ig/ref :wagoe/admin-schema-provider)
                                               :logger          (ig/ref :wagoe/logging)
                                               :error-reporter  (ig/ref :wagoe/error-reporting)
                                               :config          (:wagoe/admin active)}
              :wagoe/admin-routes          {:admin-service   (ig/ref :wagoe/admin-service)
                                               :schema-provider (ig/ref :wagoe/admin-schema-provider)
                                               :user-service    (ig/ref :wagoe/user-service)
                                               :config          (:wagoe/admin active)}})

      ;; Workflow module — enabled by `wagoe add workflow`
      workflow?
      (merge {:wagoe/workflow        {:db-ctx         (ig/ref :wagoe/db-context)
                                         :guard-registry {}}
              :wagoe/workflow-routes {:workflow-service (ig/ref :wagoe/workflow)
                                         :user-service     (ig/ref :wagoe/user-service)}})

      ;; Search module — enabled by `wagoe add search`
      search?
      (merge {:wagoe/search        {:db-ctx (ig/ref :wagoe/db-context)}
              :wagoe/search-routes {:search-service (ig/ref :wagoe/search)}})

      ;; Payments module — enabled by `wagoe add payments`
      payments?
      (assoc :wagoe/payment-provider (:wagoe/payment-provider active))

      ;; AI module — enabled by `wagoe add ai`
      ai?
      (assoc :wagoe/ai-service (:wagoe/ai-service active))

      ;; Geo module — enabled by `wagoe add geo`
      geo?
      (assoc :wagoe/geo-service (:wagoe/geo-service active))

      ;; Config-only modules — init-keys defined in {{project-ns}}.system; no component deps.
      storage?  (assoc :wagoe/storage       (:wagoe/storage active))
      jobs?     (assoc :wagoe/jobs          (:wagoe/jobs active))
      email?    (assoc :boundary.external/smtp (:boundary.external/smtp active))
      realtime? (assoc :wagoe/realtime      (:wagoe/realtime active))
      reports?  (assoc :wagoe/reports       (:wagoe/reports active))
      calendar? (assoc :wagoe/calendar      (:wagoe/calendar active))
      ui-style? (assoc :wagoe/ui-style      (:wagoe/ui-style active)))))

;; Wire integrant.repl to use this configuration.
;; Loaded automatically via dev/user.clj when starting the REPL.
(ig-repl/set-prep!
 (fn [] (ig-config (load-config))))
