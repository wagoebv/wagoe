{;; {{project-name}} — dev configuration
 :active
 { :wagoe/settings
   {:name             "{{project-name}}-dev"
    :version          "0.1.0"
    :date-format      "yyyy-MM-dd"
    :date-time-format "yyyy-MM-dd HH:mm:ss"
    ;; The zone the admin shows and reads timestamps in when the browser has
    ;; not said which it is in. Storage and the JVM stay UTC (BOU-431).
    :time-zone        "Europe/Amsterdam"
    ;; Auth cookies omit the Secure attribute for local HTTP dev.
    ;; Defaults to true (HTTPS-only) when unset — set true behind TLS in prod.
    :secure-cookies?  false
    ;; {:user-web-ui {:enabled? false}} drops the user module's HTML pages,
    ;; for an API-only app.
    :features         {}}

   ;; SQLite by default: no server to install, and unlike in-memory H2 the
   ;; data survives a restart, so the first app you build still has its rows
   ;; the next morning. Swap in :wagoe/postgresql when you need one.
   ;; Key is :db — that is what the platform's config reader looks for
   ;; (adapters/database/config.clj). :database-path is the *adapter* key it
   ;; derives, not the config key; using it here yields database-path nil and
   ;; a Malli "Invalid database configuration" failure at migrate time.
   ;; :migrate-on-start? applies pending migrations when the app boots, so a
   ;; scaffolded module's tables exist without a separate `bb migrate up`. Set
   ;; here and in the test profile, deliberately not in production: there a
   ;; migration is a reviewed deploy step, and concurrent replicas would race
   ;; each other to run it (BOU-485).
   :wagoe/sqlite
   {:db                "{{project-name}}-dev.db"
    :migrate-on-start? true
    :pool              {:minimum-idle 1 :maximum-pool-size 10}}

   :wagoe/http
   {:port       #or [#env HTTP_PORT 3000]
    :host       #or [#env HTTP_HOST "0.0.0.0"]
    :join?      false
    :port-range {:start 3000 :end 3099}}

   :wagoe/router
   ;; No :adapter — Reitit is the router (ADR-037). :conflicts nil switches off
   ;; the check that two routes cannot both match a request (BOU-356).
   {:coercion :malli :middleware []}

   ;; Dev-only. An error over HTTP answers with its WGE code and the fix, not
   ;; just "Validation failed". Comes from wagoe-devtools, which lives in the
   ;; :repl alias — so this key belongs in dev config and nowhere else. Delete
   ;; it and errors go back to the plain shape production uses.
   :wagoe/dev-error-enricher {}

   ;; An expired session is hidden from every read, but its row stays. This is
   ;; what removes it — without a schedule user_sessions grows with every login.
   ;; Retention counts from expiry; raise it if you need longer sign-in history.
   :wagoe/session-pruner
   {:enable-pruning true :retention-days 30 :interval-hours 6}

   ;; Every route needs a rule, or it answers 403: `:public true`,
   ;; `:authorization :signed-in` or `:self`, a `:permission`, or its module's
   ;; <module>/read and <module>/write, which a scaffolded module's routes get.
   ;; A platform admin passes all of them; everyone else gets rights through a
   ;; group's roles. `clojure -M:run authz-report` lists the routes.
   :wagoe/authorization
   {:mode :enforce}

   :wagoe/logging
   {:provider :slf4j :level :debug}}

 :inactive
 { ;; MySQL 8 instead of SQLite: move this into :active and :wagoe/sqlite out.
   ;; `bb setup --database mysql` writes an active one for you instead.
   :wagoe/mysql
   {:host              #or [#env MYSQL_HOST "localhost"]
    :port              #or [#long #or [#env MYSQL_PORT 3306] 3306]
    :dbname            #or [#env MYSQL_DB "wagoe_dev"]
    :user              #or [#env MYSQL_USER "root"]
    :password          #or [#env MYSQL_PASSWORD ""]
    :migrate-on-start? true}}}
