#!/usr/bin/env bash
set -euo pipefail

# Quick local gate. The full check suite runs in CI (`bb check --ci`).

# FC/IS enforcement — blocks the commit on a violation. Scans src/**/core/.
bb check:fcis

# clj-kondo, the same command `bb check` runs: a warning blocks the commit
# here as it fails CI there.
bb check:lint
