 :modules
 [;; ─── Core (always included) ───────────────────────────────────────────────
  {:name                "core"
   :description         "Pure validation, case conversion, interceptor pipeline, feature flags"
   :clojars             com.wagoe/wagoe-core
   :version             "1.0.0-beta-1"
   :category            :core
   :config-snippet      ""
   :test-config-snippet ""
   :add-command         "wagoe add core"
   :docs-url            "https://github.com/wagoebv/wagoe/blob/main/libs/core/AGENTS.md"}

  {:name                "observability"
   :description         "Interceptor-based metrics, logging, and error reporting"
   :clojars             com.wagoe/wagoe-observability
   :version             "1.0.0-beta-1"
   :category            :core
   :config-snippet      "  :wagoe/metrics\n  {:provider :no-op}\n\n  :wagoe/error-reporting\n  {:provider :no-op}\n"
   :test-config-snippet "  :wagoe/metrics\n  {:provider :no-op}\n\n  :wagoe/error-reporting\n  {:provider :no-op}\n"
   :add-command         "wagoe add observability"
   :docs-url            "https://github.com/wagoebv/wagoe/blob/main/libs/observability/AGENTS.md"}

  {:name                "platform"
   :description         "HTTP server, Reitit router, Ring middleware pipeline"
   :clojars             com.wagoe/wagoe-platform
   :version             "1.0.0-beta-1"
   :category            :core
   :config-snippet      "  :wagoe/http\n  {:port #or [#env HTTP_PORT 3000] :host \"0.0.0.0\" :join? false}\n\n  :wagoe/router\n  {:adapter :reitit :coercion :malli :middleware []}\n"
   :test-config-snippet ""
   :add-command         "wagoe add platform"
   :docs-url            "https://github.com/wagoebv/wagoe/blob/main/libs/platform/AGENTS.md"}

  {:name                "user"
