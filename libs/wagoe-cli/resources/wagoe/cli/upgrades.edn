;; What `wagoe upgrade` rewrites: one entry per `### Deprecated` entry in
;; CHANGELOG.md, matched on :ticket. `bb check:changelog` fails on a deprecation
;; with no entry here.
;;
;; An entry rewrites with one or more of these, or says why it cannot (:manual):
;;   :config-key   {[:wagoe/x :old] [:wagoe/x :new]}   ; renames a key in its own map
;;   :config-value {[:wagoe/x :key] {:old-value :new-value}}
;;   :ns-rename    {old.ns new.ns}
;;   :fn-rename    {old.ns/f new.ns/g}                  ; only when the arguments are the same
;; Config paths are looked up at the top of each config.edn and under :active
;; and :inactive.
[{:ticket "BOU-346"
  :since  "1.0.0-rc-1"
  :note   "The :wagoe/admin and :wagoe/auth-user-repository Integrant components."
  :manual "Drop them from hand-written wiring and point refs to :wagoe/auth-user-repository at :wagoe/user-repository. :wagoe/admin under :active is the module switch and stays, so a rewrite cannot tell the two apart."}

 {:ticket       "BOU-436"
  :since        "1.0.0-rc-1"
  :note         "Provider names :in-memory, :redis-streams and :database are :memory, :redis and :db."
  :config-value {[:wagoe/cache :provider]    {:in-memory :memory}
                 [:wagoe/realtime :provider] {:in-memory :memory}
                 [:wagoe/jobs :provider]     {:in-memory :memory, :database :db}
                 [:wagoe/events :provider]   {:in-memory :memory, :redis-streams :redis}}}

 {:ticket "BOU-433"
  :since  "1.0.0-rc-1"
  :note   "wagoe.jobs.shell.adapters.db/enqueue-in-tx! is wagoe.jobs.ports/enqueue-in-tx! on the queue component."
  :manual "The port takes the queue component as its first argument, which the old call has no value for."}

 {:ticket "BOU-682"
  :since  "1.0.2"
  :note   "wagoe.user.shell.middleware/jwt-authentication-middleware and protect-with-jwt without a user service."
  :manual "Pass the user service as the first argument: (jwt-authentication-middleware user-service handler). A rewrite has no user service to pass."}

 {:ticket "BOU-684"
  :since  "1.0.2"
  :note   "wagoe.platform.ports.database/like with a LIKE pattern."
  :manual "Pass a mode and the raw value: (like adapter :email :contains q). A rewrite cannot tell which % are wildcards."}

 {:ticket "BOU-705"
  :since  "1.0.2"
  :note   "wagoe.search.shell.registry: defsearch, register-search! and the global registry."
  :manual "Bind definitions with wagoe.search.core.index/defsearch and hand them to :wagoe/search, under :indexes in config or a module's :search part. A rewrite cannot tell which module owns an index."}

 {:ticket "BOU-462"
  :since  "1.0.2"
  :note   "/swagger.json and :swagger route docs (Swagger 2.0). The API docs are OpenAPI 3.1 at /openapi.json."
  :manual "Move :swagger to :openapi, with a parameter's :type under :schema and a response's :schema under :content \"application/json\". Point clients at /openapi.json. A rewrite cannot reach parameter vectors built at runtime."}]
