{:paths ["src" "resources"]

 :deps  {org.clojure/clojure {:mvn/version "1.12.7"}
         wagoe/core                  {:local/root "../core"}
         metosin/malli {:mvn/version "0.20.3"}
         ;; cheshire brings jackson-core below 2.22.3: CVE-2026-89407, CVE-2026-89425 (BOU-618).
         com.fasterxml.jackson.core/jackson-core {:mvn/version "2.22.3"}
         cheshire/cheshire {:mvn/version "6.2.1"}
         org.clojure/tools.logging {:mvn/version "1.3.2"}
         ch.qos.logback/logback-classic {:mvn/version "1.6.8"}
         io.sentry/sentry-clj           {:mvn/version "8.34.247"}
         ;; OpenTelemetry (OTLP/HTTP exporter for traces + metrics — :otlp provider)
         io.opentelemetry/opentelemetry-sdk {:mvn/version "1.68.0"}
         io.opentelemetry/opentelemetry-exporter-otlp {:mvn/version "1.68.0"}}

 :aliases
 {:test      {:extra-paths ["test"]
              :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                            io.opentelemetry/opentelemetry-sdk-testing {:mvn/version "1.68.0"}}
              :main-opts   ["-m" "kaocha.runner"]}

  :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.26"}}
              :main-opts    ["-m" "clj-kondo.main"]}

  :build     {:replace-deps {io.github.clojure/tools.build {:git/tag "v0.10.13" :git/sha "3a3c177d"}
                             slipset/deps-deploy           {:mvn/version "0.2.5"}}
              :ns-default   build}}}
