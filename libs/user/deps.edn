{:paths ["src" "resources"]

 :deps  {wagoe/config            {:local/root "../config"}
         org.clojure/clojure     {:mvn/version "1.12.5"}
         ;; wagoe.user.shell.cli requires this — it is what `bb create-admin`
         ;; reaches. Same undeclared transitive as platform (BOU-273).
         org.clojure/tools.cli   {:mvn/version "1.4.256"}
         wagoe/shared-ui  {:local/root "../shared-ui"}
         wagoe/platform       {:local/root "../platform"}
         wagoe/external       {:local/root "../external"}
         wagoe/email          {:local/root "../email"}
         wagoe/tenant         {:local/root "../tenant"}
         wagoe/cache          {:local/root "../cache"}
         wagoe/observability  {:local/root "../observability"}
         wagoe/i18n           {:local/root "../i18n"}
         wagoe/core           {:local/root "../core"}
         integrant/integrant {:mvn/version "1.0.1"}
         metosin/malli {:mvn/version "0.20.1"}
         org.clojure/tools.logging {:mvn/version "1.3.1"}
         cheshire/cheshire {:mvn/version "6.2.0"}
         ring/ring-core {:mvn/version "1.15.4"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.1108"}
         buddy/buddy-core {:mvn/version "1.12.0-430"}

         ;; Authentication
         buddy/buddy-hashers     {:mvn/version "2.0.167"}
         buddy/buddy-sign        {:mvn/version "3.6.1-359"}
         one-time/one-time       {:mvn/version "0.8.0"
                                  :exclusions  [com.github.kenglxn.qrgen/javase]}

         ;; QR code generation (local, no external service)
         com.google.zxing/core   {:mvn/version "3.5.4"}
         com.google.zxing/javase {:mvn/version "3.5.4"}

         ;; UI
         hiccup/hiccup           {:mvn/version "2.0.0"}}

 :aliases
 {:test      {:extra-paths ["test"]
              :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                            com.h2database/h2   {:mvn/version "2.4.240"}}
              :main-opts   ["-m" "kaocha.runner"]}

  :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.04.15"}}
              :main-opts    ["-m" "clj-kondo.main"]}

  :build     {:replace-deps {io.github.clojure/tools.build {:git/tag "v0.10.13" :git/sha "3a3c177d"}
                             slipset/deps-deploy           {:mvn/version "0.2.3"}}
              :ns-default   build}}}
