{:paths ["src" "resources"]

 :deps  {org.clojure/clojure {:mvn/version "1.12.7"}
         wagoe/core {:local/root "../core"}
         wagoe/platform-sql {:local/root "../platform-sql"}
         wagoe/i18n       {:local/root "../i18n"}
         integrant/integrant {:mvn/version "1.0.1"}
         org.clojure/tools.logging {:mvn/version "1.3.2"}
         cheshire/cheshire {:mvn/version "6.2.1"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
         com.github.seancorfield/honeysql {:mvn/version "2.8.85"}}

 :aliases
 {:test      {:extra-paths ["test"]
              :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                            ;; Booting system-config loads the always-on email module.
                            wagoe/email {:local/root "../email"}
                            ;; The admin pages render with it; apps bring it (BOU-932).
                            wagoe/shared-ui {:local/root "../shared-ui"}
                            com.h2database/h2 {:mvn/version "2.5.252"}
                            org.xerial/sqlite-jdbc {:mvn/version "3.54.1.0"}}
              :main-opts   ["-m" "kaocha.runner"]}

  :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.26"}}
              :main-opts    ["-m" "clj-kondo.main"]}

  :build     {:replace-deps {io.github.clojure/tools.build {:git/tag "v0.10.13" :git/sha "3a3c177d"}
                             slipset/deps-deploy           {:mvn/version "0.2.5"}}
              :ns-default   build}}}
