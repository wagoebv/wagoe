{:paths ["src" "resources"]

 :deps  {org.clojure/clojure       {:mvn/version "1.12.6"}
         wagoe/core {:local/root "../core"}
         wagoe/platform         {:local/root "../platform"}
         integrant/integrant {:mvn/version "1.0.1"}
         metosin/malli             {:mvn/version "0.20.1"}
         org.clojure/tools.logging {:mvn/version "1.3.1"}
         clj-http/clj-http         {:mvn/version "3.13.1"}
         cheshire/cheshire         {:mvn/version "6.2.0"}
         jakarta.mail/jakarta.mail-api {:mvn/version "2.1.5"}
         org.eclipse.angus/angus-mail  {:mvn/version "2.0.5"}
         ;; Deprecated: nothing here uses it any more. Kept for apps that import
         ;; javax.mail themselves; removed in 2.0.
         com.sun.mail/javax.mail   {:mvn/version "1.6.2"}
         commons-net/commons-net   {:mvn/version "3.13.0"}}

 :aliases
 {:test      {:extra-paths ["test"]
              :extra-deps  {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                            com.icegreen/greenmail {:mvn/version "2.1.14"
                                                    :exclusions [org.eclipse.angus/jakarta.mail junit/junit]}
                            org.apache.ftpserver/ftpserver-core {:mvn/version "1.2.1"}
                            org.apache.mina/mina-core {:mvn/version "2.2.10"}}
              :main-opts   ["-m" "kaocha.runner"]}

  :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
              :main-opts    ["-m" "clj-kondo.main"]}

  :build     {:replace-deps {io.github.clojure/tools.build {:git/tag "v0.10.13" :git/sha "3a3c177d"}
                             slipset/deps-deploy           {:mvn/version "0.2.5"}}
              :ns-default   build}}}
