#!/usr/bin/env bash
# Gate 1 of trunk-based development (BOU-1025): a push to main runs `bb check`.
# Other branches push freely. Bypass in an emergency: git push --no-verify.
set -euo pipefail

zero=0000000000000000000000000000000000000000
to_main=false
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "$zero" ]; then
    to_main=true
  fi
done
$to_main || exit 0

# bb check tests the working tree; it must be what is pushed.
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: commit or stash your changes first, so bb check tests what you push." >&2
  exit 1
fi

exec bb check
