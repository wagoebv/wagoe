#kaocha/v1
 {;; All library source paths (shared by all test suites)
  :kaocha/source-paths ["src"
                        "libs/core/src"
                        "libs/observability/src"
                        "libs/platform/src"
                        "libs/user/src"
                        "libs/admin/src"
                        "libs/storage/src"
                        "libs/scaffolder/src"
                        "libs/cache/src"
                        "libs/jobs/src"
                        "libs/email/src"
                        "libs/tenant/src"
                        "libs/realtime/src"
                        "libs/payments/src"
                        "libs/external/src"
                        "libs/workflow/src"
                        "libs/search/src"
                        "libs/reports/src"
                        "libs/calendar/src"
                        "libs/geo/src"
                        "libs/ai/src"
                        "libs/ui-style/src"
                        "libs/shared-ui/src"
                        "libs/i18n/src"
                        "libs/devtools/src"
                        "libs/push/src"
                        "libs/audience/src"]

  :tests [{:id :unit
           :test-paths ["test"
                        "libs/config/test"
                        "libs/core/test"
                        "libs/observability/test"
                        "libs/platform/test"
                        "libs/user/test"
                        "libs/admin/test"
                        "libs/storage/test"
                        "libs/scaffolder/test"
                        "libs/cache/test"
                        "libs/jobs/test"
                        "libs/email/test"
                        "libs/tenant/test"
                        "libs/realtime/test"
                        "libs/payments/test"
                        "libs/external/test"
                        "libs/workflow/test"
                        "libs/search/test"
                        "libs/reports/test"
                        "libs/calendar/test"
                        "libs/geo/test"
                        "libs/ai/test"
                        "libs/ui-style/test"
                        "libs/shared-ui/test"
                        "libs/i18n/test"
                        "libs/devtools/test"
                        "libs/push/test"
                        "libs/audience/test"]
           :ns-patterns ["wagoe.*-test"]
           :randomize? true}

         ;; Per-library test suites
         ;; Usage: clojure -M:test :core
          {:id :core
           :test-paths ["libs/core/test"]
           :ns-patterns ["wagoe.core.*-test"]}

          {:id :observability
           :test-paths ["libs/observability/test"]
           :ns-patterns ["wagoe.observability.*-test"]}

          {:id :platform
           :test-paths ["libs/platform/test"]
           :ns-patterns ["wagoe.platform.*-test"]}

          {:id :user
           :test-paths ["libs/user/test"]
           :ns-patterns ["wagoe.user.*-test"]}

          {:id :admin
           :test-paths ["libs/admin/test"]
           :ns-patterns ["wagoe.admin.*-test"]}

          {:id :storage
           :test-paths ["libs/storage/test"]
           :ns-patterns ["wagoe.storage.*-test"]}

          {:id :scaffolder
           :test-paths ["libs/scaffolder/test"]
           :ns-patterns ["wagoe.scaffolder.*-test"]}

          {:id :cache
           :test-paths ["libs/cache/test"]
           :ns-patterns ["wagoe.cache.*-test"]}

          {:id :events
           :test-paths ["libs/events/test"]
           :ns-patterns ["wagoe.events.*-test"]}

          {:id :jobs
           :test-paths ["libs/jobs/test"]
           :ns-patterns ["wagoe.jobs.*-test"]}

          {:id :email
           :test-paths ["libs/email/test"]
           :ns-patterns ["wagoe.email.*-test"]}

          {:id :tenant
           :test-paths ["libs/tenant/test"]
           :ns-patterns ["wagoe.tenant.*-test"]}

          {:id :realtime
           :test-paths ["libs/realtime/test"]
           :ns-patterns ["wagoe.realtime.*-test"]}

          {:id :payments
           :test-paths ["libs/payments/test"]
           :ns-patterns ["wagoe.payments.*-test"]}

          {:id :external
           :test-paths ["libs/external/test"]
           :ns-patterns ["wagoe.external.*-test"]}

          {:id :workflow
           :test-paths ["libs/workflow/test"]
           :ns-patterns ["wagoe.workflow.*-test"]}

          {:id :search
           :test-paths ["libs/search/test"]
           :ns-patterns ["wagoe.search.*-test"]}

          {:id :reports
           :test-paths ["libs/reports/test"]
           :ns-patterns ["wagoe.reports.*-test"]}

          {:id :calendar
           :test-paths ["libs/calendar/test"]
           :ns-patterns ["wagoe.calendar.*-test"]}

          {:id :geo
           :test-paths ["libs/geo/test"]
           :ns-patterns ["wagoe.geo.*-test"]}

          {:id :ai
           :test-paths ["libs/ai/test"]
           :ns-patterns ["wagoe.ai.*-test"]}

          {:id :ui-style
           :test-paths ["libs/ui-style/test"]
           :ns-patterns ["wagoe.ui-style.*-test"]}

          {:id :shared-ui
           :test-paths ["libs/shared-ui/test"]
           :ns-patterns ["wagoe.shared.*-test"]}

          {:id :i18n
           :test-paths ["libs/i18n/test"]
           :ns-patterns ["wagoe.i18n.*-test"]}

          {:id :devtools
           :test-paths ["libs/devtools/test"]
           :ns-patterns ["wagoe.devtools.*-test"]}

          {:id :push
           :test-paths ["libs/push/test"]
           :source-paths ["libs/push/src"]
           :ns-patterns ["wagoe.push.*-test"]}

          {:id :audience
           :test-paths ["libs/audience/test"]
           :ns-patterns ["wagoe.audience.*-test"]}

         ;; End-to-end suite lives in tests.e2e.edn so default
         ;; clojure -M:test runs stay opt-in and do not require spel.
          ]

  :plugins [:kaocha.plugin/randomize
            :kaocha.plugin/filter
            :kaocha.plugin/profiling]

 ;; Enable metadata-based filtering for focus-meta.
 ;; Examples:
 ;;   ^:unit        → clojure -M:test --focus-meta :unit
 ;;   ^:integration → clojure -M:test --focus-meta :integration
 ;;   ^:user        → clojure -M:test --focus-meta :user
  :kaocha.plugin.filter/focus-meta [:unit :integration :contract :property :security :e2e :user :billing :phase3]

  :kaocha.plugin.randomize/randomize? true
  :kaocha/reporter [wagoe.test.reporter/reporter]

  :kaocha/fail-fast? false
  :kaocha/color? true
  :kaocha/watch? false}
